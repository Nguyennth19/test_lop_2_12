/** V6.2: Phone login. The email field in session is an internal legacy actor alias only. */
function secretV6_(){return Array.from({length:5},()=>Utilities.getUuid().replace(/-/g,'')).join('').slice(0,64);}
function hashV6_(value){const pepper=PropertiesService.getScriptProperties().getProperty('AUTH_PEPPER');if(!pepper)throw Error('Chưa có AUTH_PEPPER.');return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(String(value),pepper)).replace(/=+$/,'');}
function normalizePhoneV6_(value){const raw=String(value||'').replace(/[\s().-]/g,'');let n=raw;if(/^\+84\d+$/.test(n))n='0'+n.slice(3);else if(/^84\d+$/.test(n))n='0'+n.slice(2);if(!/^0[35789]\d{8}$/.test(n))throw Error('Số điện thoại Việt Nam phải gồm 10 số, bắt đầu bằng 03/05/07/08/09.');return n;}
function userV6_(phone){let p;try{p=normalizePhoneV6_(phone);}catch(e){return null;}const r=rows_(APP.sheets.users).find(x=>{const raw=String(x.v[0]||'').trim();try{return normalizePhoneV6_(raw.length===9&&/^[35789]\d{8}$/.test(raw)?'0'+raw:raw)===p;}catch(e){return false;}});return r?{row:r.row,phone:p,email:p,role:String(r.v[1]||'').toUpperCase(),hash:String(r.v[2]||''),active:String(r.v[3]||'').toUpperCase()==='ACTIVE'}:null;}
function authV6_(token,roles){if(typeof token!=='string'||token.length!==64)throw Error('Cần đăng nhập quản lý.');const raw=CacheService.getScriptCache().get('v6s_'+hashV6_(token).slice(0,52));if(!raw)throw Error('Phiên đăng nhập hết hạn.');const s=JSON.parse(raw),u=userV6_(s.phone||s.email);if(!u||!u.active||u.role!==s.role||u.hash!==s.keyHash||(roles&&!roles.includes(u.role)))throw Error('Không có quyền thực hiện thao tác.');return s;}
function loginV6(phone,password){const p=normalizePhoneV6_(phone),k=String(password||'');if(k.length<6||k.length>128)throw Error('Số điện thoại hoặc mật khẩu không hợp lệ.');const cache=CacheService.getScriptCache(),tk='v6fail_'+p;const count=Number(cache.get(tk)||0);if(count>=8)throw Error('Tạm khóa đăng nhập 15 phút.');const u=userV6_(p),valid=!!(u&&u.active&&['ADMIN','EDITOR'].includes(u.role)&&u.hash===hashV6_(p+'|'+k));if(!valid){cache.put(tk,String(count+1),900);sh_(APP.sheets.loginAudit).appendRow([new Date(),p,'LOGIN',false,'Invalid credentials']);throw Error('Số điện thoại hoặc mật khẩu không đúng.');}cache.remove(tk);const token=secretV6_();cache.put('v6s_'+hashV6_(token).slice(0,52),JSON.stringify({phone:p,email:p,role:u.role,keyHash:u.hash}),APP.sessionSeconds);sh_(APP.sheets.loginAudit).appendRow([new Date(),p,'LOGIN',true,'']);return {token,phone:p,email:p,role:u.role,expiresIn:APP.sessionSeconds};}
function logoutV6(token){try{const s=authV6_(token);CacheService.getScriptCache().remove('v6s_'+hashV6_(token).slice(0,52));sh_(APP.sheets.loginAudit).appendRow([new Date(),s.phone||s.email,'LOGOUT',true,'']);}catch(e){}return {ok:true};}
function whoamiV6(token){const a=authV6_(token);return {phone:a.phone||a.email,role:a.role};}
function listUsersV6(token){authV6_(token,['ADMIN']);return rows_(APP.sheets.users).map(r=>({phone:String(r.v[0]),role:String(r.v[1]),active:String(r.v[3])==='ACTIVE'}));}
function grantUserV6(token,phone,role){const actor=authV6_(token,['ADMIN']);const p=normalizePhoneV6_(phone),r=String(role||'').toUpperCase();if(!['ADMIN','EDITOR'].includes(r))throw Error('Vai trò không hợp lệ.');throw Error('Hãy tạo / đặt lại mật khẩu qua menu Quản lý tài khoản trong Google Sheets.');}
function revokeUserV6(token,phone){const actor=authV6_(token,['ADMIN']),u=userV6_(phone);if(!u)throw Error('Không tìm thấy tài khoản.');if(u.phone===(actor.phone||actor.email))throw Error('Không thể tự thu hồi quyền.');const admins=rows_(APP.sheets.users).filter(x=>String(x.v[1]).toUpperCase()==='ADMIN'&&String(x.v[3]).toUpperCase()==='ACTIVE').length;if(u.role==='ADMIN'&&admins<=1)throw Error('Phải còn ít nhất một Admin.');sh_(APP.sheets.users).getRange(u.row,4).setValue('DISABLED');auditV6_(actor.email,'REVOKE_USER','',u.phone);return {ok:true};}
/** First ADMIN is created safely in the bound Sheet sidebar by the document owner. */
function bootstrapAdminV6(){throw Error('V6.2: mở menu Quản lý tài khoản trong Google Sheets và tạo Admin đầu tiên bằng số điện thoại.');}
