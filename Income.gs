function saveCashV6(p){const a=authV6_(p&&p.token,['ADMIN','EDITOR']);assertCashSchemaV746_();const date=inputDate_(p.date),payerId=required_(p.payerId,100),amount=money_(p.amount);if(!amount)throw Error('Số tiền phải lớn hơn 0.');const student=roster_().find(x=>String(x.id)===payerId);if(!student)throw Error('Vui lòng chọn học sinh trong danh sách.');const prior=p.id?find_(APP.sheets.cash,p.id):null;if(p.id&&(!prior||!active_(prior,9)))throw Error('Không tìm thấy giao dịch cần sửa.');if(!prior&&student.status!=='ACTIVE')throw Error('Chỉ có thể ghi khoản thu mới cho học sinh đang học.');const name=clean_(p.payerName,150),batch=clean_(p.batch,100)||(prior?String(prior.v[4]||''):defaultCashBatchV744_()),method=clean_(p.method,60),note=clean_(p.note,400);const reason=prior?requireChangeReasonV74_(p.reason):'Tạo mới';const id=prior?String(prior.v[0]):newId_('PT'),photo=uploadV6_(p.image,'cash');const v=[id,date,payerId,name,batch,amount,method||'Chuyển khoản',note,photo.id||(prior?String(prior.v[8]||''):''),'ACTIVE',prior?prior.v[10]:a.email,prior?prior.v[11]:new Date(),new Date(),'',prior?String(prior.v[14]||''):accountTitleV744_(a.email)];commitFinancialChangeV74_(a.email,APP.sheets.cash,id,prior,v,prior?'UPDATE_CASH':'CREATE_CASH',reason);return {ok:true,id};}
