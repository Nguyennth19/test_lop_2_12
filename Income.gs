 cash:rows_(APP.sheets.cash).filter(r=>active_(r,9)).map(r=>({id:String(r.v[0]),date:dateV6_(r.v[1]),payerId:String(r.v[2]),payerName:String(r.v[3]),batch:String(r.v[4]),amount:Number(r.v[5]||0),method:String(r.v[6]),note:String(r.v[7]),hasPhoto:!!r.v[8]})).sort((a,b)=>b.date.localeCompare(a.date)),
