function saveGoodsV6(p){const a=authV6_(p&&p.token,['ADMIN','EDITOR']),date=inputDate_(p.date),studentId=required_(p.studentId,100),product=required_(p.product,200),quantity=Number(p.quantity),estimated=0;if(!Number.isFinite(quantity)||quantity<=0||quantity>100000)throw Error('Số lượng không hợp lệ.');const child=roster_().find(x=>x.id===studentId);if(!child)throw Error('Vui lòng chọn học sinh trong danh sách.');const prior=p.id?find_(APP.sheets.goods,p.id):null;if(p.id&&(!prior||!active_(prior,11)))throw Error('Không tìm thấy hiện vật.');if(!prior&&child.status!=='ACTIVE')throw Error('Chỉ có thể ghi hiện vật mới cho học sinh đang học.');const donor=clean_(p.donor,150)||('Phụ huynh bé '+child.child),unit=clean_(p.unit,30)||'cái',note=clean_(p.note,300),publish='PUBLIC';const reason=prior?requireChangeReasonV74_(p.reason):'Tạo mới';const photo=uploadV6_(p.image,'goods'),id=prior?String(prior.v[0]):newId_('HV');const v=[id,date,studentId,donor,product,quantity,unit,estimated,photo.id||(prior?String(prior.v[8]||''):''),note,publish,'ACTIVE',prior?prior.v[12]:a.email,prior?prior.v[13]:new Date(),new Date()];commitFinancialChangeV74_(a.email,APP.sheets.goods,id,prior,v,prior?'UPDATE_GOODS':'CREATE_GOODS',reason);return {ok:true,id};}
